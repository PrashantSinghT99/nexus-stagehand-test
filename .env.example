# Nexus Automate Environment Configuration

# App Configuration
BASE_URL=https://www.saucedemo.com
TEST_TIMEOUT_MS=30000

# Stagehand / AI Configuration (Ollama & OpenAI Supported)
STAGEHAND_LOG_LEVEL=info
STAGEHAND_ENV=LOCAL

# For Local Ollama Execution:
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:1.5b

# For Cloud OpenAI Execution:
# STAGEHAND_MODEL=gpt-4o
# OPENAI_API_KEY=your_openai_api_key_here

# User Credentials Registry
E2E_ADMIN_EMAIL=standard_user
E2E_ADMIN_PASSWORD=secret_sauce
E2E_USER_EMAIL=standard_user
E2E_USER_PASSWORD=secret_sauce
